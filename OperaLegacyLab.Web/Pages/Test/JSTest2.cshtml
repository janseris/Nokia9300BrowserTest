@page "/jstest2"
@model OperaLegacyLab.Web.Pages.JSTest2Model
@{
}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"
    "http://www.w3.org/TR/html4/loose.dtd">

<html>
<head>
    <title>Loading</title>

    <style type="text/css">
        body {
            background-color: #111111;
            color: #FFFFFF;
            font-family: Arial, Helvetica, sans-serif;
            text-align: center;
            padding-top: 100px;
        }

        #bar {
            width: 300px;
            height: 8px;
            background-color: #333333;
            margin-left: auto;
            margin-right: auto;
            margin-top: 20px;
        }

        #progress {
            height: 8px;
            background-color: #FFFFFF;
            width: 0px;
        }
    </style>

    <script type="text/javascript">
    <!--

    var target = 2781;
    var current = 0;
    var startTime = 0;
    var duration = 4000;

    function loadNumber()
    {
        var now;
        var elapsed;
        var progress;
        var eased;

        now = new Date().getTime();

        if (startTime == 0)
        {
            startTime = now;
        }

        elapsed = now - startTime;
        progress = elapsed / duration;

        if (progress > 1)
        {
            progress = 1;
        }

        /*
         * Ease-out:
         * fast at first, slower near 2781.
         */
        eased = 1 - ((1 - progress) *
                     (1 - progress) *
                     (1 - progress));

        current = Math.floor(target * eased);

        document.numberForm.numberField.value = current;
        document.numberForm.percentField.value =
            Math.floor(progress * 100) + "%";

        document.getElementById("progress").style.width =
            Math.floor(progress * 300) + "px";

        if (progress < 1)
        {
            setTimeout("loadNumber()", 50);
        }
        else
        {
            document.numberForm.numberField.value = "2781";
            document.numberForm.percentField.value = "100%";
        }
    }

    //-->
    </script>
</head>

<body>

<form name="numberForm">

    <input type="text"
           name="numberField"
           value="0">

    <br><br>

    <input type="text"
           name="percentField"
           value="0%">

</form>

<div id="bar">
    <div id="progress"></div>
</div>

<script type="text/javascript">
<!--
loadNumber();
//-->
</script>

</body>
</html>